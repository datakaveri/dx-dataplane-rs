{
  "version": "1.0",
  "zookeepers": [
    "zookeeper"
  ],
  "clusterId": "iudx-rs-cluster",
  "host": "rs.iudx.io",
  "commonConfig": {
    "dxApiBasePath": "/ngsi-ld/v2",
    "timeLimit": "test,2020-10-22T00:00:00Z,20",
    "timeLimitForAsync": 365,
    "tenantPrefix": "iudx-v2",
    "redisKeyPrefix": "dx",
    "supportEmail": "support@cdpg.org.in",
    "gatewayurl": "rs.forest-stack.digivan.forest.rajasthan.gov.in/rsp",
    "ngsildurl": "rs.forest-stack.digivan.forest.rajasthan.gov.in",
    "publishedurl": "rs.forest-stack.digivan.forest.rajasthan.gov.in/published",
    "corsAllowedOrigin": [
      "*",
      "http://localhost:4001"
    ],
    "controlPlaneDomain": "https://v2.dev.controlplane.iudx.io",
    "controlplaneHost": "localhost",
    "controlplaneGrpcPort": 9090,
    "appIdCacheMaxSize": 1000,
    "appIdCacheTtlMinutes": 5,
    "appIdRevokeExchange": "revoked-appid",
    "appIdRevokeQueue": "revoked-appid",
    "issuers": {
      "jwtIgnoreExpiry": true,
      "leeway": 60,
      "jwksRefreshIntervalMs": 21600000,
      "v2.dev.controlplane.iudx.io": {
        "type": "remote",
        "jwksUrl": "https://v2.dev.controlplane.iudx.io/iudx/v2/auth/jwks",
        "audience": []
      },
      "https://staging.keycloak.update.iudx.io/auth/realms/tgdex-pilot": {
        "type": "remote",
        "jwksUrl": "https://staging.keycloak.update.iudx.io/auth/realms/tgdex-pilot/protocol/openid-connect/certs",
        "audience": []
      }
    }
  },
  "modules": [
    {
      "id": "org.cdpg.dx.database.postgres.verticle.PostgresVerticle",
      "isWorkerVerticle": false,
      "verticleInstances": 1,
      "databaseIP": "",
      "databasePort": 5434533,
      "databaseName": "iudx_rs",
      "databaseUserName": "",
      "databasePassword": "",
      "poolSize": 25,
      "databaseSchema": "public"
    },
    {
      "id": "org.cdpg.dx.databroker.DataBrokerVerticle",
      "isWorkerVerticle": false,
      "verticleInstances": 1,
      "dataBrokerIP": "",
      "dataBrokerPort": 245345368,
      "prodVhost": "",
      "internalVhost": "",
      "externalVhost": "",
      "dataBrokerUserName": "",
      "dataBrokerPassword": "",
      "dataBrokerManagementPort": 280345342,
      "connectionTimeout": 6000,
      "requestedHeartbeat": 60,
      "handshakeTimeout": 6000,
      "requestedChannelMax": 5,
      "networkRecoveryInterval": 500,
      "automaticRecoveryEnabled": "true",
      "brokerAmqpIp": "",
      "brokerAmqpPort": 245673453,
      "adapterQueryPublishExchange": "rpc-adapter-requests"
    },
    {
      "id": "org.cdpg.dx.database.elastic.ElasticsearchVerticle",
      "isWorkerVerticle": false,
      "verticleInstances": 2,
      "databaseIP": "",
      "databasePort": 24324034,
      "databaseUser": "",
      "databasePassword": ""
    },
    {
      "id": "org.cdpg.dx.cloudstorage.s3.verticle.S3Verticle",
      "isWorkerVerticle": false,
      "verticleInstances": 1,
      "s3AccessKey": "",
      "s3SecretKey": "",
      "s3Bucket": "",
      "s3Region": "",
      "s3ProxyTimeoutMs": 240000
    },
    {
      "id": "org.cdpg.dx.apiserver.ApiServerVerticle",
      "isWorkerVerticle": false,
      "verticleInstances": 1,
      "ssl": true,
      "production": false,
      "httpPort": 8443,
      "isAdexInstance": false,
      "keystore": "configs/keystore.jks",
      "keystorePassword": "password",
      "urnPrefix": "dx:dataplane:"
    },
    {
      "id": "org.cdpg.dx.apiserver.ProxyApiServerVerticle",
      "isWorkerVerticle": false,
      "verticleInstances": 1,
      "ssl": true,
      "production": false,
      "httpPort": 8444,
      "isAdexInstance": false,
      "keystore": "configs/keystore.jks",
      "keystorePassword": "password",
      "urnPrefix": "dx:dataplaneProxy:",
      "maxDaysSync": 10,
      "maxDaysAsync": 365
    },
    {
      "id": "org.cdpg.dx.apiserver.PublishedApiServerVerticle",
      "required": ["commonConfig"],
      "isWorkerVerticle": false,
      "verticleInstances": 1,
      "ssl": true,
      "production": false,
      "httpPort": 8445,
      "isAdexInstance": false,
      "keystore": "configs/keystore.jks",
      "keystorePassword": "password",
      "urnPrefix": "dx:dataplanePublish:",
      "chunkMaxItems" : 2000,
      "chunkMaxBytes" : 30,
      "timeout": 500000
    }
  ]
}